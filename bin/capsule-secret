#!/usr/bin/env bash
# Vendor-neutral secrets helper (spec
# docs/superpowers/specs/2026-09-07-secrets-server-design.md section 3; P06 of the
# public portable edition). Callers never learn the backend: get/run/export/check
# are the whole surface. Backend = CAPSULE_SECRETS_BACKEND:
#   file       $CAPSULE_HOME/secrets.env (KEY=VALUE), refused unless mode 0600
#   infisical  the Infisical CLI (identity files under $CAPSULE_CONFIG_DIR)
#   env        the process environment (CI, containers)
# Precedence: CAPSULE_SECRETS_BACKEND > secrets.backend in $CAPSULE_HOME/host.json > autodetect:
# a machine that already has an Infisical config ($CAPSULE_CONFIG_DIR/projects.env) and no
# secrets.env resolves through infisical; any other machine defaults to file; both present is
# ambiguous and exits 3. Only an unreadable host.json, bad JSON or a bad secrets.backend value
# refuses (exit 3, no value echoed); every other host.json key is ignored here.
# No secret value is ever put on argv, here or to the CLI.
#
# keychain (D227): infisical backend only. For the allow-listed keys (_CS_KEYCHAIN_KEYS:
# SLACK_BOT_TOKEN, SLACK_APP_TOKEN; the listener needs the app token with Docker down) `get <project>`
# asks the macOS Keychain after the identity checks and project resolve (so a missing
# CAPSULE_IDENTITY still refuses, and only project capsule-corp qualifies) and BEFORE login, so Slack
# pages work while Docker (and Infisical in it) is down. Lookup: `security find-generic-password -s
# capsule-corp -a <KEY> -w` (/usr/bin/security; SECURITY_BIN is the test hook), bounded by
# CAPSULE_KEYCHAIN_WAIT_S (default 10; a locked Keychain can block; timeout = miss). A miss falls
# through to login/Infisical, unchanged. The file and env backends never consult the Keychain. The
# value goes to stdout only (never argv, never env, `security`'s stderr is dropped).
# `keychain-check <KEY>` = presence only: exit 0 ok, 3 missing, bad name or not allow-listed, 4 no
# `security` binary (not macOS); it never prints the value.
#
# secrets.env format: one KEY=VALUE per line, `export ` prefix allowed, a value may be wrapped
# in one pair of single or double quotes. No inline comments, no escape sequences, no
# expansion; whole-line `#` comments and blank lines are skipped. Any other line is ignored
# with a warning naming its line number (never its content). Empty values are present.
# The env backend reads the process environment (printenv). Script-owned names carry a
# _CS_ prefix and never reach a child; only the input names (CAPSULE_*, INFISICAL_*, CURL_BIN)
# are assigned here, so do not use those as secret keys. Leading and trailing tabs are
# stripped from file values.
#
# infisical's own stderr (login/get/run failures) is passed through to our
# stderr as-is, for a human to read interactively - callers must never
# capture it verbatim into logs, since it can echo request details.
set -euo pipefail

CAPSULE_IDENTITY="${CAPSULE_IDENTITY:-}"
CAPSULE_CONFIG_DIR="${CAPSULE_CONFIG_DIR:-$HOME/.config/capsule}"
# Self-hosted Infisical serves its API under /api; the CLI's own default
# (https://app.infisical.com/api) carries the same suffix, verified against
# infisical 0.43.129.
INFISICAL_API_URL="${INFISICAL_API_URL:-http://localhost:8085/api}"
INFISICAL_BIN="${INFISICAL_BIN:-infisical}"
CAPSULE_SECRET_WAIT_S="${CAPSULE_SECRET_WAIT_S:-60}"
CAPSULE_SECRET_WAIT_STEP_S="${CAPSULE_SECRET_WAIT_STEP_S:-2}"
CAPSULE_SECRET_STATUS_URL="${CAPSULE_SECRET_STATUS_URL:-${INFISICAL_API_URL}/status}"
CURL_BIN="${CURL_BIN:-curl}"

die() { echo "capsule-secret: $1" >&2; exit 3; }

# Boot race (spec section 2): launchd may start us before Docker/Infisical
# answer. Poll /status, then log in. 0 = no wait (tests, heal's own check).
wait_for_server() {
  local waited=0 step
  [ "$CAPSULE_SECRET_WAIT_S" -gt 0 ] || return 0
  # step 0 is deliberately allowed (tests want an instant loop): bound
  # progress by max(step, 1) so the budget always advances and the loop
  # cannot spin forever when CAPSULE_SECRET_WAIT_STEP_S=0.
  step="$CAPSULE_SECRET_WAIT_STEP_S"; [ "$step" -ge 1 ] || step=1
  while ! "$CURL_BIN" -fsS -m 2 "$CAPSULE_SECRET_STATUS_URL" >/dev/null 2>&1; do
    [ "$waited" -ge "$CAPSULE_SECRET_WAIT_S" ] && die "infisical not answering after ${CAPSULE_SECRET_WAIT_S}s"
    sleep "$CAPSULE_SECRET_WAIT_STEP_S"; waited=$((waited + step))
  done
}

usage() {
  echo "usage: capsule-secret get <project> <NAME> | run <project> -- <cmd...> | export <project> | check [--identity-all] | backend | keychain-check <NAME>" >&2
  exit 2
}

[ $# -ge 1 ] || usage
_CS_CMD="$1"; shift

_CS_KEYCHAIN_KEYS=" SLACK_BOT_TOKEN SLACK_APP_TOKEN "
SECURITY_BIN="${SECURITY_BIN:-/usr/bin/security}"
# keychain_get <KEY>: prints the value and returns 0 on a hit; returns 1 on any miss (not
# allow-listed, no `security`, no item, empty, timeout). The value goes to stdout only.
keychain_get() {
  case "$_CS_KEYCHAIN_KEYS" in *" $1 "*) ;; *) return 1 ;; esac
  command -v "$SECURITY_BIN" >/dev/null 2>&1 || return 1
  local v lim=()
  command -v perl >/dev/null 2>&1 && lim=(perl -e 'alarm shift; exec @ARGV' "${CAPSULE_KEYCHAIN_WAIT_S:-10}")
  v="$(${lim[@]+"${lim[@]}"} "$SECURITY_BIN" find-generic-password -s capsule-corp -a "$1" -w 2>/dev/null)" || return 1
  [ -n "$v" ] || return 1
  printf '%s\n' "$v"
}
if [ "$_CS_CMD" = keychain-check ]; then
  [ $# -eq 1 ] || usage
  [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "bad secret name"
  case "$_CS_KEYCHAIN_KEYS" in *" $1 "*) ;; *) die "not keychain-allowed: $1" ;; esac
  command -v "$SECURITY_BIN" >/dev/null 2>&1 || { echo "capsule-secret: no security binary (not macOS)" >&2; exit 4; }
  keychain_get "$1" >/dev/null || die "not in keychain: $1"
  echo "capsule-secret: ok (keychain $1)"; exit 0
fi

# CAPSULE_HOME rule (row 609; the same block is in every script that defaults it, = capsule/paths.py home()): explicit wins; under AGENT_OPS_NO_SEND a temp dir, never the live home.
# Known differences from tempfile.gettempdir(): TEMP/TMP are not read without TMPDIR; a missing or unwritable TMPDIR falls back to /tmp only in Python; only one trailing slash is stripped; a relative TMPDIR is not made absolute.
if [ -z "${CAPSULE_HOME:-}" ]; then
  if [ -n "${AGENT_OPS_NO_SEND:-}" ]; then CAPSULE_HOME="${TMPDIR:-/tmp}"; CAPSULE_HOME="${CAPSULE_HOME%/}/capsule-home-no-send"
  else CAPSULE_HOME="$HOME/.local/share/capsule"; fi
fi
_CS_SECRETS_FILE="$CAPSULE_HOME/secrets.env"
_CS_BACKEND="${CAPSULE_SECRETS_BACKEND:-}"
_CS_FROM="CAPSULE_SECRETS_BACKEND"
# host.json (any entry, even a directory or a dangling link) is read by the Capsule reader, so
# the validation stays in capsule/host.py: the installed launcher when executable (it pins the
# interpreter and the repo), else the repo this script lives in (symlinks followed). A copy
# outside the repo with no launcher cannot read it and says so. Stdout is accepted only if it
# is a backend word or empty; stderr is read only for the refusal reason, never echoed whole.
_CS_HJ="$CAPSULE_HOME/host.json"
if [ -z "$_CS_BACKEND" ] && { [ -e "$_CS_HJ" ] || [ -L "$_CS_HJ" ]; }; then
  _CS_FROM="host.json"
  _cs_p="${BASH_SOURCE[0]}"
  while [ -L "$_cs_p" ]; do
    _cs_d="$(dirname "$_cs_p")"; _cs_p="$(readlink "$_cs_p")"
    case "$_cs_p" in /*) ;; *) _cs_p="$_cs_d/$_cs_p" ;; esac
  done
  _CS_REPO="$(cd -P "$(dirname "$_cs_p")/.." && pwd -P)"
  # A FIFO would hang the reader, so only a regular file (or a link to one) is read.
  [ -f "$_CS_HJ" ] || die "refusing host.json secrets.backend: not a regular file"
  # An explicit CAPSULE_BIN that is not executable is an error; only the default may be absent.
  if [ -n "${CAPSULE_BIN:-}" ] && [ ! -x "$CAPSULE_BIN" ]; then
    die "refusing host.json secrets.backend: CAPSULE_BIN is not an executable file"
  fi
  _CS_BIN="${CAPSULE_BIN:-$HOME/.local/bin/capsule}"
  _cs_args=(host get secrets.backend --only --capsule-home "$CAPSULE_HOME")
  # The reader gets CAPSULE_SECRET_READ_S seconds (default 20); macOS has no timeout binary.
  _cs_t="${CAPSULE_SECRET_READ_S:-20}"; _cs_lim=()
  command -v perl >/dev/null 2>&1 && _cs_lim=(perl -e 'alarm shift; exec @ARGV' "$_cs_t")
  _cs_err="$(mktemp)"
  trap 'rm -f "$_cs_err"' EXIT; trap 'exit 130' INT; trap 'exit 143' TERM
  if [ -x "$_CS_BIN" ]; then
    _CS_BACKEND="$(${_cs_lim[@]+"${_cs_lim[@]}"} "$_CS_BIN" "${_cs_args[@]}" 2>"$_cs_err")" \
      || _cs_rc=$?
  elif [ -f "$_CS_REPO/capsule/host.py" ]; then
    # `python -P` needs 3.11+; an older interpreter would answer a raw "Unknown option: -P".
    _cs_py="${CAPSULE_PY:-python3}"
    _cs_pv="$(${_cs_lim[@]+"${_cs_lim[@]}"} "$_cs_py" -I -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])' </dev/null 2>/dev/null || true)"
    case "$_cs_pv" in [0-9]*.[0-9]*.[0-9]*) ;; *) _cs_pv="" ;; esac
    _cs_pm="${_cs_pv#*.}"; _cs_pm="${_cs_pm%%.*}"
    if [ "${_cs_pv%%.*}" != 3 ] || ! [ "$_cs_pm" -ge 11 ] 2>/dev/null; then
      die "needs Python 3.11+ (CAPSULE_PY=$_cs_py is ${_cs_pv:-unknown})"
    fi
    _CS_BACKEND="$(PYTHONPATH="$_CS_REPO" ${_cs_lim[@]+"${_cs_lim[@]}"} \
      env -u PYTHONINSPECT -u PYTHONSTARTUP "$_cs_py" -s -P -m capsule "${_cs_args[@]}" 2>"$_cs_err")" || _cs_rc=$?
  else
    die "host.json is present but there is no capsule launcher: install it or set CAPSULE_BIN"
  fi
  _cs_why="$(grep '^capsule host: ' "$_cs_err" | tail -n 1 || true)"
  _cs_why="${_cs_why#capsule host: }"; _cs_why="${_cs_why#"$_CS_HJ": }"
  if [ -n "${_cs_rc:-}" ] && [ -z "$_cs_why" ]; then
    if [ "$_cs_rc" = 142 ]; then _cs_why="the reader timed out after ${_cs_t}s"
    elif ! grep -q 'unrecognized arguments' "$_cs_err"; then
      _cs_why="$(grep -v '^import time:' "$_cs_err" | head -n 1 | cut -c1-200 || true)"
    fi
    : "${_cs_why:=reinstall the capsule launcher (it may predate host get --only)}"
  fi
  rm -f "$_cs_err"; trap - EXIT INT TERM
  [ -z "${_cs_rc:-}" ] || die "refusing host.json secrets.backend: $_cs_why"
  case "$_CS_BACKEND" in
    ''|file|infisical|env) ;;
    *) die "refusing host.json secrets.backend: reader gave an unexpected answer" ;;
  esac
fi
if [ -z "$_CS_BACKEND" ]; then
  if [ -e "$_CS_SECRETS_FILE" ] && [ -f "$CAPSULE_CONFIG_DIR/projects.env" ]; then
    die "ambiguous: set CAPSULE_SECRETS_BACKEND (both $_CS_SECRETS_FILE and $CAPSULE_CONFIG_DIR/projects.env exist)"
  elif [ -f "$CAPSULE_CONFIG_DIR/projects.env" ]; then
    _CS_BACKEND=infisical
  else
    _CS_BACKEND=file
  fi
  _CS_FROM=autodetect
fi
case "$_CS_BACKEND" in
  file|infisical|env) ;;
  *) die "unknown backend: $_CS_FROM is not file, infisical or env" ;;
esac

# `backend` prints the effective backend (callers pick compose profiles from it).
if [ "$_CS_CMD" = backend ]; then echo "$_CS_BACKEND"; exit 0; fi

# --- file backend: a plain KEY=VALUE file, never sourced (no code runs) ---
file_mode() { stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1" 2>/dev/null; }

# Fail closed: the file must exist, be a regular file and be exactly 0600.
# Never echoes contents.
file_guard() {
  [ ! -L "$_CS_SECRETS_FILE" ] || die "refusing $_CS_SECRETS_FILE: it is a symlink"
  [ -f "$_CS_SECRETS_FILE" ] || die "no secrets file: $_CS_SECRETS_FILE"
  local mode owner
  owner="$(stat -c %u "$_CS_SECRETS_FILE" 2>/dev/null || stat -f %u "$_CS_SECRETS_FILE" 2>/dev/null)" || die "cannot stat $_CS_SECRETS_FILE"
  [ "$owner" = "$(id -u)" ] || die "refusing $_CS_SECRETS_FILE: owned by uid $owner, not the current user"
  mode="$(file_mode "$_CS_SECRETS_FILE")" || die "cannot stat $_CS_SECRETS_FILE"
  [ "$mode" = 600 ] || die "refusing $_CS_SECRETS_FILE: mode is $mode, must be 600 (chmod 600)"
}

# Prints "KEY<TAB>VALUE" per entry (last duplicate wins at the consumer).
file_entries() {
  local line key val n=0
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line="${line%$'\r'}"
    case "$line" in ''|'#'*) continue ;; esac
    line="${line#export }"
    case "$line" in *=*) ;; *) echo "capsule-secret: warning: $_CS_SECRETS_FILE line $n ignored (not KEY=VALUE)" >&2; continue ;; esac
    key="${line%%=*}"; val="${line#*=}"
    [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { echo "capsule-secret: warning: $_CS_SECRETS_FILE line $n ignored (bad key)" >&2; continue; }
    case "$val" in
      \"*\") val="${val#\"}"; val="${val%\"}" ;;
      \'*\') val="${val#\'}"; val="${val%\'}" ;;
    esac
    printf '%s\t%s\n' "$key" "$val"
  done <"$_CS_SECRETS_FILE"
}

file_get() {
  local want="$1" k v found=0 out=""
  while IFS=$'\t' read -r k v; do
    if [ "$k" = "$want" ]; then found=1; out="$v"; fi
  done < <(file_entries)
  [ "$found" = 1 ] || die "no such secret: $want"
  printf '%s\n' "$out"
}

backend_nonfile() {
  case "$_CS_CMD" in
    get)
      [ $# -eq 2 ] || usage
      [[ "$2" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "bad secret name"
      if [ "$_CS_BACKEND" = file ]; then file_guard; file_get "$2"; return; fi
      # printenv, not ${!2}: only the real environment counts, and an empty value is present.
      local v
      v="$(printenv "$2")" || die "no such secret: $2"
      printf '%s\n' "$v"
      ;;
    run)
      [ $# -ge 1 ] || usage
      shift
      [ "${1:-}" = "--" ] || usage
      shift
      [ $# -ge 1 ] || usage
      if [ "$_CS_BACKEND" = file ]; then
        file_guard
        local k v
        while IFS=$'\t' read -r k v; do export "$k=$v"; done < <(file_entries)
      fi
      exec "$@"
      ;;
    export)
      [ $# -eq 1 ] || usage
      [ "$_CS_BACKEND" = file ] || die "export is not supported by the env backend"
      file_guard
      local k v
      while IFS=$'\t' read -r k v; do printf "%s='%s'\n" "$k" "${v//\'/\'\\\'\'}"; done < <(file_entries)
      ;;
    check)
      case "${1:-}" in
        '') ;;
        --identity-all) [ $# -eq 1 ] || usage ;;
        --project) [ $# -eq 2 ] || usage ;;
        *) usage ;;
      esac
      if [ "$_CS_BACKEND" = file ]; then file_guard; fi
      echo "capsule-secret: ok ($_CS_BACKEND)"
      ;;
    *) usage ;;
  esac
}

case "$_CS_BACKEND" in
  file|env) backend_nonfile "$@"; exit 0 ;;
  infisical) ;;
  *) die "unknown CAPSULE_SECRETS_BACKEND (valid: file, infisical, env)" ;;
esac

# --- infisical backend (unchanged behaviour) ---
# Exported (infisical path only, so the env backend never offers these as secrets) (not just resolved) so the check --identity-all recursion below
# ("$0" check --project <slug>) sees the parent's effective settings even
# when the caller set one of these without exporting it themselves.
export CAPSULE_CONFIG_DIR INFISICAL_API_URL INFISICAL_BIN \
  CAPSULE_SECRET_WAIT_S CAPSULE_SECRET_WAIT_STEP_S CURL_BIN
# No default: an unset CAPSULE_IDENTITY must fail closed, not silently run
# as the most-privileged identity (bridge, scoped to all five projects).
[ -n "$CAPSULE_IDENTITY" ] || die "set CAPSULE_IDENTITY"

_CS_PROJECTS_ENV="$CAPSULE_CONFIG_DIR/projects.env"
_CS_IDENTITY_ENV="$CAPSULE_CONFIG_DIR/identities/$CAPSULE_IDENTITY.env"

[ -f "$_CS_PROJECTS_ENV" ] || die "no projects file: $_CS_PROJECTS_ENV"
[ -f "$_CS_IDENTITY_ENV" ] || die "no identity file for $CAPSULE_IDENTITY"

# A syntax error inside a `.`-sourced file aborts a non-interactive bash
# outright, bypassing any `||` on the source line itself - so check syntax
# first with `bash -n` (no execution) and fail closed before sourcing.
bash -n "$_CS_PROJECTS_ENV" || die "malformed config: $_CS_PROJECTS_ENV"
bash -n "$_CS_IDENTITY_ENV" || die "malformed config: $_CS_IDENTITY_ENV"
# shellcheck disable=SC1090
. "$_CS_PROJECTS_ENV" || die "malformed config: $_CS_PROJECTS_ENV"
# shellcheck disable=SC1090
. "$_CS_IDENTITY_ENV" || die "malformed config: $_CS_IDENTITY_ENV"

project_id() {
  local project="$1"
  local slug_upper var
  slug_upper="$(printf '%s' "$project" | tr '[:lower:]-' '[:upper:]_')"
  var="PROJECT_${slug_upper}"
  local id="${!var:-}"
  [ -n "$id" ] || die "no project id for $project"
  printf '%s' "$id"
}

login() {
  wait_for_server
  local tok
  # Credentials travel in the CLI's own environment variables, never argv
  # (argv is world-readable through ps).
  if ! tok="$(INFISICAL_UNIVERSAL_AUTH_CLIENT_ID="$INFISICAL_CLIENT_ID" \
      INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET="$INFISICAL_CLIENT_SECRET" \
      "$INFISICAL_BIN" login --method=universal-auth \
      --domain="$INFISICAL_API_URL" --silent --plain)"; then
    die "login failed for identity $CAPSULE_IDENTITY"
  fi
  [ -n "$tok" ] || die "login failed for identity $CAPSULE_IDENTITY"
  printf '%s' "$tok"
}

check_one() {
  local project="$1"
  local pid tok
  pid="$(project_id "$project")"
  tok="$(login)"
  INFISICAL_TOKEN="$tok" "$INFISICAL_BIN" secrets get CAPSULE_CHECK --projectId="$pid" --env=prod --domain="$INFISICAL_API_URL" --plain >/dev/null 2>&1 \
    || die "cannot read CAPSULE_CHECK from $project as $CAPSULE_IDENTITY"
  echo "capsule-secret: ok ($CAPSULE_IDENTITY)"
}

case "$_CS_CMD" in
  get)
    [ $# -eq 2 ] || usage
    _CS_PROJECT="$1"; _CS_NAME="$2"
    _CS_PID="$(project_id "$_CS_PROJECT")"
    if [ "$_CS_PROJECT" = capsule-corp ] && keychain_get "$_CS_NAME"; then exit 0; fi
    _CS_TOKEN="$(login)"
    INFISICAL_TOKEN="$_CS_TOKEN" exec "$INFISICAL_BIN" secrets get "$_CS_NAME" --projectId="$_CS_PID" --env=prod --domain="$INFISICAL_API_URL" --plain
    ;;
  run)
    [ $# -ge 1 ] || usage
    _CS_PROJECT="$1"; shift
    [ "${1:-}" = "--" ] || usage
    shift
    _CS_PID="$(project_id "$_CS_PROJECT")"
    _CS_TOKEN="$(login)"
    # The child must not inherit the access token or the identity credentials the helper
    # itself needed (an identity file may export them, or the caller may have them set).
    INFISICAL_TOKEN="$_CS_TOKEN" exec "$INFISICAL_BIN" run --projectId="$_CS_PID" --env=prod --domain="$INFISICAL_API_URL" -- \
      env -u INFISICAL_TOKEN -u INFISICAL_CLIENT_ID -u INFISICAL_CLIENT_SECRET \
      -u INFISICAL_UNIVERSAL_AUTH_CLIENT_ID -u INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET "$@"
    ;;
  export)
    [ $# -eq 1 ] || usage
    _CS_PID="$(project_id "$1")"
    _CS_TOKEN="$(login)"
    INFISICAL_TOKEN="$_CS_TOKEN" exec "$INFISICAL_BIN" export --format=dotenv --projectId="$_CS_PID" --env=prod --domain="$INFISICAL_API_URL"
    ;;
  check)
    # check's exit code is a documented contract for callers (spec section
    # 3: "exit 0 when the server answers and the identity can read the
    # Capsule project"), so unlike get/run below (which deliberately `exec`
    # and let the CLI's own status pass straight through - defensible
    # there, since those two hand control to the caller's command) a
    # failed read here must become our exit 3 with a `capsule-secret:`
    # line, not a bare CLI exit 1 and silence.
    if [ "${1:-}" = "--identity-all" ]; then
      [ $# -eq 1 ] || usage
      _CS_rc=0
      # Without nullglob an empty (or missing) directory hands the loop the
      # literal `*.env` pattern, which would then be checked as an identity
      # named `*` and produce a confusing "no identity file for *". Say what
      # is actually wrong instead, and fail closed - "every identity can
      # read" must never be answered by "there are none".
      shopt -s nullglob
      _CS_IDENTITY_FILES=("$CAPSULE_CONFIG_DIR"/identities/*.env)
      shopt -u nullglob
      [ "${#_CS_IDENTITY_FILES[@]}" -gt 0 ] || die "no identity files under $CAPSULE_CONFIG_DIR/identities"
      for _CS_f in "${_CS_IDENTITY_FILES[@]}"; do
        _CS_id="$(basename "$_CS_f" .env)"
        # "agent-ops" here names a live Infisical project distinct from this
        # repo's name (rename/capsule-corp, row 200s inventory item B7) - do
        # not rename it to follow the repo rename.
        _CS_proj=capsule-corp; [ "$_CS_id" = bridge ] && _CS_proj=agent-ops
        if CAPSULE_IDENTITY="$_CS_id" "$0" check --project "$_CS_proj"; then :; else _CS_rc=3; fi
      done
      exit $_CS_rc
    fi
    _CS_CHECK_PROJECT=capsule-corp
    if [ "${1:-}" = "--project" ]; then
      [ $# -eq 2 ] || usage
      _CS_CHECK_PROJECT="$2"
    elif [ $# -ne 0 ]; then
      usage
    fi
    check_one "$_CS_CHECK_PROJECT"
    ;;
  *)
    usage
    ;;
esac
