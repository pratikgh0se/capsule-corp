@@ -0,0 +1,11 @@
+import unittest
+
+from pager import page_slice
+
+
+class PageSliceTests(unittest.TestCase):
+    def test_page_has_at_most_size_items(self):
+        self.assertEqual(len(page_slice(list(range(10)), 2, 3)), 3)
+
+    def test_out_of_range_page_is_empty(self):
+        self.assertEqual(page_slice(list(range(10)), 9, 3), [])
