{"id": "file-mode-0644-refused", "given": {"document": {"check": "capsule_secret", "backend": "file", "secrets_file_mode": "0644", "secrets_file_content": "DEMO_KEY=fake", "command": "get demo DEMO_KEY"}}, "expect": {"exit": 3, "stdout": "", "stderr": "mode is 644", "pass": "file-mode-0644-refused: names the mode, leaks no value"}, "source": "owner"}
{"id": "missing-key-is-nonzero-exit", "given": {"document": {"check": "capsule_secret", "backend": "file", "secrets_file_mode": "0600", "secrets_file_content": "DEMO_KEY=fake", "command": "get demo MISSING_KEY"}}, "expect": {"exit": 3, "stdout": "", "stderr": "no such secret: MISSING_KEY", "pass": "missing-key-is-nonzero-exit (file)"}, "source": "owner"}
{"id": "backend-infisical-unchanged", "given": {"document": {"check": "capsule_secret", "backend": "infisical", "fake_cli_value": "infisical-value", "command": "get demo DEMO_KEY"}}, "expect": {"exit": 0, "stdout": "infisical-value", "pass": "backend-infisical-unchanged: explicit infisical resolves through the CLI"}, "source": "owner"}
{"id": "host-json-backend-wins", "given": {"document": {"check": "capsule_secret", "host_json": {"secrets": {"backend": "env"}}, "command": "backend"}}, "expect": {"exit": 0, "stdout": "env"}, "source": "owner"}
{"id": "env-var-beats-host-json", "given": {"document": {"check": "capsule_secret", "host_json": {"secrets": {"backend": "env"}}, "env": {"CAPSULE_SECRETS_BACKEND": "file"}, "command": "backend"}}, "expect": {"exit": 0, "stdout": "file"}, "source": "owner"}
{"id": "host-json-bad-backend-refused", "given": {"document": {"check": "capsule_secret", "host_json": {"secrets": {"backend": "vaultx"}}, "command": "backend"}}, "expect": {"exit": 3, "stdout": "", "stderr": "secrets.backend"}, "source": "owner"}
