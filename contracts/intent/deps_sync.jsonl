{"id": "first-sync-fetches-every-listed-package-and-says-got", "given": {"document": {"check": "deps_sync", "case": "first_sync"}}, "expect": {"exit": 0, "tail": "deps-sync: 0 ok, 2 got, 0 failed", "fetched": 2, "events": 2, "note": "two allowlisted packages, empty cache: each is fetched once, recorded, and logged as a sync event"}, "source": "row 217, 2026-10-28"}
{"id": "second-run-finds-everything-ok-and-fetches-nothing", "given": {"document": {"check": "deps_sync", "case": "second_run"}}, "expect": {"exit": 0, "tail": "deps-sync: 2 ok, 0 got, 0 failed", "fetched": 0, "events": 0, "note": "the manifest line and the cached file are both still there, so nothing is fetched and no event is written"}, "source": "row 217, 2026-10-28"}
{"id": "malformed-allowlist-line-refuses-the-whole-run", "given": {"document": {"check": "deps_sync", "case": "malformed_allowlist_line"}}, "expect": {"exit": 2, "stderr": "BAD repo-c/deps-allowlist.txt:2: pip:badpkg>=1.0.0", "fetched": 0, "note": "one bad line (a version range) in any repo: exit 2 naming the file and line, before anything is fetched"}, "source": "row 217, 2026-10-28"}
