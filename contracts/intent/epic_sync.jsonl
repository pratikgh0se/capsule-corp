{"id": "clean-merge-of-origin-main-records-synced-sha", "given": {"document": {"check": "epic_sync", "clone_is_dirty": false, "nothing_new_on_main": false, "merge_would_conflict": false}}, "expect": {"card_marked_done": true, "event": "epic_synced"}, "source": "owner"}
{"id": "nothing-new-on-main-is-not-recorded-as-a-sync", "given": {"document": {"check": "epic_sync", "clone_is_dirty": false, "nothing_new_on_main": true}}, "expect": {"card_marked_done": true, "event": null}, "source": "row 515"}
{"id": "conflicting-merge-blocks-the-card-never-the-clone", "given": {"document": {"check": "epic_sync", "clone_is_dirty": false, "nothing_new_on_main": false, "merge_would_conflict": true}}, "expect": {"card_marked_done": false, "block_kind": "epic_sync_conflict", "clone_left_clean": true}, "source": "owner"}
{"id": "clean-publish-puts-gate-passed-commit-on-host-branch", "given": {"document": {"check": "epic_publish", "nothing_new_on_main": true, "host_branch_moved": false}}, "expect": {"card_marked_done": true, "commit_on_host_branch": true}, "source": "owner"}
{"id": "moved-host-branch-holds-the-card-never-forces", "given": {"document": {"check": "epic_publish", "nothing_new_on_main": true, "host_branch_moved": true}}, "expect": {"card_marked_done": false, "commit_on_host_branch": false, "block_kind": "epic_sync_error"}, "source": "owner"}
{"id": "idle-epic-picks-up-moved-main-within-one-tick", "given": {"document": {"check": "epic_sync_idle", "nothing_new_on_main": false, "merge_would_conflict": false, "card_holds_clone": false, "clone_is_dirty": false}}, "expect": {"clone_contains_origin_main": true, "event": "epic_synced", "card_held": false}, "source": "owner"}
{"id": "idle-epic-conflict-is-an-event-never-a-held-card", "given": {"document": {"check": "epic_sync_idle", "nothing_new_on_main": false, "merge_would_conflict": true, "card_holds_clone": false, "clone_is_dirty": false}}, "expect": {"clone_contains_origin_main": false, "event": "epic_sync_conflict", "card_held": false, "clone_left_clean": true}, "source": "owner"}
{"id": "live-card-with-pinned-start-sha-blocks-idle-sync", "given": {"document": {"check": "epic_sync_idle", "nothing_new_on_main": false, "merge_would_conflict": false, "card_holds_clone": true, "clone_is_dirty": false}}, "expect": {"clone_contains_origin_main": false, "event": null, "card_held": false}, "source": "owner"}
{"id": "foreign-leftover-is-backed-up-then-cleaned-before-launch", "given": {"document": {"check": "lane_leftover", "clone_is_dirty": true, "leftover": "foreign"}}, "expect": {"refused": false, "clone_left_clean": true, "backup_exists": true}, "source": "row 624"}
{"id": "own-dirt-is-untouched-and-the-card-starts", "given": {"document": {"check": "lane_leftover", "clone_is_dirty": true, "leftover": "own"}}, "expect": {"refused": false, "clone_left_clean": false, "backup_exists": false}, "source": "row 624"}
{"id": "backup-failure-blocks-the-card-and-leaves-the-clone-as-is", "given": {"document": {"check": "lane_leftover", "clone_is_dirty": true, "leftover": "foreign", "backup_fails": true}}, "expect": {"refused": true, "clone_left_clean": false, "backup_exists": false}, "source": "row 624"}
