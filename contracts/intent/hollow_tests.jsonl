{"id": "reviewer-bundle-names-a-changed-test-with-no-assertion", "given": {"document": {"scenario": "bundle-hollow", "changed_test": "capsule/tests/test_x.py", "hollow_name": "test_x", "test_text": "def test_x():\n    y = 1 + 1\n"}}, "expect": {"section": true, "named": true, "diff_kept": true}, "source": "owner"}
{"id": "clean-or-non-test-diff-or-read-failure-adds-no-section", "given": {"document": {"scenario": "bundle-quiet", "clean_test": "def test_x():\n    assert f() == 1\n", "non_test_file": "README.md"}}, "expect": {"sections": 0, "bundles_built": 3}, "source": "owner"}
{"id": "swift-and-ts-tests-without-assertions-are-named-others-not", "given": {"document": {"scenario": "swift-ts", "swift_hollow": "final class A: XCTestCase {\n  func testX() { let v = f() }\n}\n", "ts_hollow": "it(\"x\", () => { f(); });\n", "swift_clean": ["func testX() { XCTAssertEqual(f(), 1) }\n", "func assertOk(_ v: Int) { XCTAssertEqual(v, 1) }\nfunc testX() { assertOk(f()) }\n"], "ts_clean": ["it(\"x\", () => { expect(f()).toBe(1); });\n", "function checkOk(v) { expect(v).toBe(1); }\nit(\"x\", () => { checkOk(f()); });\n"]}}, "expect": {"hollow_named": 2, "clean_named": 0}, "source": "owner"}
