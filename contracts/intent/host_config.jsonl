{"id": "missing-host-json-keeps-prefix-and-backend-on-auto", "given": {"document": {"host_json": "absent"}}, "expect": {"prefix_get": "", "backend_get": "", "check_says_auto": true, "check_host_row": "ok"}, "source": "owner"}
{"id": "typo-or-bad-value-fails-loudly-naming-the-key", "given": {"document": {"host_json": {"launchd": {"label_prefx": "com.example"}}, "names": "label_prefx"}}, "expect": {"check_host_row": "FAIL", "check_names_key": true, "get_exit": 1, "get_names_key": true}, "source": "owner"}
{"id": "env-beats-file-and-empty-env-is-unset", "given": {"document": {"host_json": {"launchd": {"label_prefix": "com.file"}, "secrets": {"backend": "infisical"}}, "env": {"CAPSULE_LAUNCHD_PREFIX": "com.env", "CAPSULE_SECRETS_BACKEND": ""}}}, "expect": {"prefix_get": "com.env", "backend_get": "infisical"}, "source": "owner"}
{"id": "project-lists-default-to-this-repo-or-nothing", "given": {"document": {"host_json": "absent"}}, "expect": {"quality_repos_get": "capsule-corp", "secrets_projects_get": "capsule-corp", "scan_repos_get": "", "components_get": "", "repos_get_names": "capsule-corp"}, "source": "owner"}
{"id": "list-get-space-separated-check-shows-names-not-paths", "given": {"document": {"host_json": {"maintenance": {"scan_repos": ["a", "b"]}, "repos": {"a": "/private/path/a"}}}}, "expect": {"scan_repos_get": "a b", "check_names_repos": true, "check_shows_paths": false}, "source": "owner"}
{"id": "list-key-wrong-type-refused-naming-key-no-value", "given": {"document": {"host_json": {"quality": {"repos": "SECRETVALUE"}}, "names": "quality.repos", "value": "SECRETVALUE"}}, "expect": {"list_get_exit": 1, "list_err_names_key": true, "list_err_echoes_value": false}, "source": "owner"}
{"id": "repo-urls-default-to-nothing", "given": {"document": {"host_json": {"repos": {"a": "/private/path/a"}}}}, "expect": {"repo_urls_get": "", "repos_get_names": "a"}, "source": "owner"}
{"id": "repo-urls-bad-value-refused-naming-key-no-value", "given": {"document": {"host_json": {"repo_urls": {"a": "SECRETVALUE"}}, "names": "repo_urls", "value": "SECRETVALUE"}}, "expect": {"repo_urls_get_exit": 1, "repo_urls_err_names_key": true, "repo_urls_err_echoes_value": false}, "source": "owner"}
