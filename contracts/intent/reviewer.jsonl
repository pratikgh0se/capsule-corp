{"id": "review-passes-single-caller-wrapper", "given": {"document": {"schema": "review_verdict.v1", "role": "reviewer", "findings": "<empty>"}, "inputs": {"diff": "--- a/capsule/x.py\n+++ b/capsule/x.py\n@@ -1,3 +1,8 @@\n+def _load(path):\n+    return read_json(path)\n+\n+\n def run(path):\n-    return read_json(path)\n+    return _load(path)\n"}}, "expect": {"findings": {"<some>": {"class": "least_code"}}}, "source": "row 559"}
{"id": "review-passes-unrequested-options", "given": {"document": {"schema": "review_verdict.v1", "role": "reviewer", "findings": "<empty>"}, "inputs": {"diff": "--- a/capsule/x.py\n+++ b/capsule/x.py\n@@ -1,3 +1,4 @@\n-def run(path):\n+def run(path, fmt=\"json\", strict=False, retries=0):\n     return read_json(path)\n"}}, "expect": {"findings": {"<some>": {"class": "more_than_needed"}}}, "source": "row 559"}
{"id": "security-finding-on-a-matcher-form-still-fails", "given": {"document": {"schema": "review_verdict.v1", "role": "reviewer", "findings": {"<some>": {"class": "security"}}}}, "expect": {"verdict": "fail"}, "source": "owner"}
{"id": "answer-never-waives-a-security-finding", "given": {"document": {"schema": "review_verdict.v1", "role": "reviewer", "findings": {"<some>": {"class": "security"}}}, "inputs": {"interventions": "<non-empty>"}}, "expect": {"verdict": "fail"}, "source": "owner"}
