{"id": "fail-without-findings", "given": {"document": {"schema": "review_verdict.v1", "verdict": "fail", "findings": "<empty>"}}, "expect": {"findings": "<non-empty>"}, "source": "row 363"}
{"id": "fail-with-new-finding-at-round-4", "given": {"document": {"schema": "review_verdict.v1", "verdict": "fail", "findings": {"<each>": {"safety": {"<not>": true}, "class": {"<not>": "security"}}}}, "inputs": {"round": 4}}, "expect": {"verdict": "pass"}, "source": "row 540"}
{"id": "fail-with-new-finding-past-round-4", "given": {"document": {"schema": "review_verdict.v1", "verdict": "fail", "findings": {"<each>": {"safety": {"<not>": true}, "class": {"<not>": "security"}}}}, "inputs": {"round": 5}}, "expect": {"verdict": "pass"}, "source": "row 540"}
{"id": "late-safety-finding-fails-at-round-4", "given": {"document": {"schema": "review_verdict.v1", "findings": {"<some>": {"safety": true}}}, "inputs": {"round": 4}}, "expect": {"verdict": "fail"}, "source": "owner"}
{"id": "late-safety-finding-fails-past-round-4", "given": {"document": {"schema": "review_verdict.v1", "findings": {"<some>": {"safety": true}}}, "inputs": {"round": 5}}, "expect": {"verdict": "fail"}, "source": "owner"}
