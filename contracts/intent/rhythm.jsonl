{"id": "sunday-morning-is-zero-even-without-saturday-zero", "given": {"document": {"check": "rhythm", "case": "rhythm enabled, saturday_zero false", "variants": ["2026-11-15T10:00 (Sunday)", "2026-11-15T17:59 (Sunday)"]}}, "expect": {"dispatch": false, "land_product": false, "land_harness": false}, "source": "row 629"}
