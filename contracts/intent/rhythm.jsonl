{"id": "window-end-minute-is-outside", "given": {"document": {"check": "rhythm", "case": "rhythm enabled with defaults", "variants": ["2026-11-11T17:00 (Wednesday)", "2026-11-15T18:00 (Sunday)"]}}, "expect": {"dispatch": true, "land_harness": true}, "source": "row 600"}
