{"id": "no-tick-lock-free-fails", "given": {"document": {"check": "tick_guard", "lock_held": false, "lock_pid": null, "argv_pids": []}}, "expect": {"level": "FAIL", "detail": "no tick (lock free)"}, "source": "row 517"}
{"id": "lock-held-and-argv-agree-is-ok", "given": {"document": {"check": "tick_guard", "lock_held": true, "lock_pid": 4242, "argv_pids": [4242]}}, "expect": {"level": "ok", "detail": "lock held by pid 4242"}, "source": "row 517"}
{"id": "argv-disagrees-with-the-lock-fails-and-names-pids", "given": {"document": {"check": "tick_guard", "lock_held": true, "lock_pid": 111, "argv_pids": [111, 222]}}, "expect": {"level": "FAIL", "detail": "lock pid 111 vs argv pids [111, 222] disagree"}, "source": "row 517"}
{"id": "board-tick-with-no-config-stays-stopped", "given": {"document": {"check": "board_guard", "board": "B", "config_exists": false}}, "expect": {"level": "exit0", "detail": "no config for board B; nothing to serve"}, "source": "row 503"}
{"id": "board-tick-with-a-config-runs", "given": {"document": {"check": "board_guard", "board": "C", "config_exists": true}}, "expect": {"level": "ok", "detail": "runs"}, "source": "row 503"}
{"id": "no-board-unreadable-config-refuses", "given": {"document": {"check": "no_board", "scenario": "unreadable", "board": null}}, "expect": {"level": "exit3", "detail": "no lock"}, "source": "row 545"}
{"id": "no-board-readable-config-locks-and-serves-its-board", "given": {"document": {"check": "no_board", "scenario": "readable", "board": "b9"}}, "expect": {"level": "ok", "detail": "locks and serves b9"}, "source": "row 545"}
{"id": "no-board-config-raced-after-lock-is-refused", "given": {"document": {"check": "no_board", "scenario": "race", "board": "b9", "raced_board": "b10"}}, "expect": {"level": "refused", "detail": "config_error, b10 never served"}, "source": "row 545"}
{"id": "human-apply-park-and-close-take-effect-without-a-pass", "given": {"document": {"check": "human_apply", "lock_held": false, "queued": ["park", "close"], "statuses": ["ready", "ready"]}}, "expect": {"exit": 0, "statuses": ["blocked", "done"], "files_left": 0, "task_runs": 0, "outbox_sent": 0}, "source": "owner"}
{"id": "human-apply-refuses-beside-a-live-tick", "given": {"document": {"check": "human_apply", "lock_held": true, "queued": ["park", "close"], "statuses": ["ready", "ready"]}}, "expect": {"exit": 3, "statuses": ["ready", "ready"], "files_left": 2}, "source": "row 517"}
{"id": "human-apply-names-a-refused-close-as-refused", "given": {"document": {"check": "human_apply", "lock_held": false, "queued": ["close"], "statuses": ["review"]}}, "expect": {"exit": 0, "statuses": ["review"], "files_left": 0, "reported": ["refused"]}, "source": "owner"}
