{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/decision.v1.json",
  "title": "A choice put to the owner (row 416; replaces DECISION blocks, U1 incident 1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "task_id", "claim_lock", "question", "options", "recommended"],
  "properties": {
    "schema": {"const": "decision.v1"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "task_id": {"type": "string", "pattern": "^t_[0-9a-f]{8}$"},
    "claim_lock": {"type": "string", "minLength": 1, "maxLength": 200},
    "question": {"type": "string", "minLength": 1, "maxLength": 1000},
    "options": {"type": "array", "minItems": 2, "maxItems": 6, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "label"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]{1,20}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 300},
        "amendment": {"type": "array", "minItems": 1, "maxItems": 3, "items": {
          "type": "object", "additionalProperties": false, "required": ["target", "find", "replace"],
          "properties": {
            "target": {"enum": ["card", "spec_section"]},
            "find": {"type": "string", "minLength": 1, "maxLength": 2000},
            "replace": {"type": "string", "maxLength": 2400}}}}}}},
    "recommended": {"type": "string", "pattern": "^[a-z0-9-]{1,20}$"},
    "context": {"type": "string", "maxLength": 2000},
    "scope": {"enum": ["product", "text", "harness"]},
    "provisional": {"enum": ["release", "release-capsule-fault", null]},
    "reversible": {"type": "boolean"},
    "if_no_answer": {"type": "string", "minLength": 1, "maxLength": 600},
    "searched": {"type": "array", "minItems": 1, "maxItems": 8, "items": {
      "type": "object", "additionalProperties": false, "required": ["source", "query", "hits"],
      "properties": {
        "source": {"enum": ["ledger", "repo", "incidents", "vault", "recall"]},
        "query": {"type": "string", "minLength": 1, "maxLength": 300},
        "hits": {"type": "array", "maxItems": 10, "items": {
          "type": "object", "additionalProperties": false, "required": ["ref", "quote"],
          "properties": {"ref": {"type": "string", "minLength": 1, "maxLength": 300},
                         "quote": {"type": "string", "minLength": 20, "maxLength": 600}}}}}}}
  }
}
