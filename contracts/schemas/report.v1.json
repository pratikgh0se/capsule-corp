{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/report.v1.json",
  "title": "Run report and checkpoint (rows 367, 416, 417)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "task_id", "claim_lock", "role", "status",
               "implemented", "left_undone", "commands", "issues",
               "procedures_followed"],
  "properties": {
    "schema": {"const": "report.v1"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "task_id": {"type": "string", "pattern": "^t_[0-9a-f]{8}$"},
    "claim_lock": {"type": "string", "minLength": 1, "maxLength": 200},
    "role": {"type": "string", "minLength": 1, "maxLength": 64},
    "status": {"enum": ["done", "checkpoint", "failed"]},
    "implemented": {"type": "array", "maxItems": 50,
                    "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "left_undone": {"type": "array", "maxItems": 50,
                    "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "commands": {"type": "array", "maxItems": 100, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["cmd", "exit"],
      "properties": {
        "cmd": {"type": "string", "minLength": 1, "maxLength": 1000},
        "exit": {"type": "integer", "minimum": 0, "maximum": 255},
        "excerpt": {"type": "string", "maxLength": 2000}}}},
    "issues": {"type": "array", "maxItems": 50,
               "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "notes": {"type": "array", "maxItems": 50,
              "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "follow_ups": {"type": "array", "maxItems": 20, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "files", "body"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "files": {"type": "array", "minItems": 1, "maxItems": 20,
                  "items": {"type": "string", "minLength": 1, "maxLength": 300}},
        "body": {"type": "string", "minLength": 1, "maxLength": 2000}}}},
    "host_only": {"type": "array", "maxItems": 50,
                  "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "procedures_followed": {"type": "array", "maxItems": 50,
                            "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "error": {"type": "string", "maxLength": 2000},
    "net_lines": {"type": "string", "minLength": 1, "maxLength": 40,
                  "pattern": "^\\+[0-9]+/-[0-9]+$"},
    "could_have_deleted": {"type": "string", "minLength": 1, "maxLength": 500},
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["done_so_far", "next_steps", "files_touched"],
      "properties": {
        "done_so_far": {"type": "string", "minLength": 1, "maxLength": 4000},
        "next_steps": {"type": "array", "minItems": 1, "maxItems": 20,
                       "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "files_touched": {"type": "array", "maxItems": 200,
                          "items": {"type": "string", "minLength": 1, "maxLength": 300}},
        "open_questions": {"type": "array", "maxItems": 20,
                           "items": {"type": "string", "minLength": 1, "maxLength": 500}}}}
  }
}
