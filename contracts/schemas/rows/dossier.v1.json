{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/rows/dossier.v1.json",
  "title": "One owner-question dossier (ask gate, design 2026-11-23 section 4; written by capsule/ask_gate.py under <board>/asks/dossiers/)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "board",
    "subject",
    "fingerprint",
    "asker",
    "at",
    "question",
    "options",
    "recommended",
    "if_no_answer",
    "reversible",
    "blast",
    "class",
    "searched"
  ],
  "properties": {
    "schema": {
      "const": "dossier.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^dq_[0-9a-f]{8}\\Z"
    },
    "board": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "asker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "at": {
      "type": "integer",
      "minimum": 0
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,20}\\Z"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "recommended": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,20}\\Z"
    },
    "if_no_answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "reversible": {
      "type": "boolean"
    },
    "undo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "blast": {
      "enum": [
        "card",
        "epic",
        "board",
        "repo",
        "outside"
      ]
    },
    "class": {
      "enum": [
        "technical",
        "product",
        "scope",
        "taste",
        "money",
        "release",
        "safety",
        "access",
        "outward"
      ]
    },
    "searched": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "query",
          "hits"
        ],
        "properties": {
          "source": {
            "enum": [
              "ledger",
              "repo",
              "incidents",
              "vault",
              "recall"
            ]
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "hits": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "quote"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "quote": {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 600
                }
              }
            }
          }
        }
      }
    },
    "plain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "what": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "if_yes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "if_no": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "pick": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "because": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    }
  }
}
