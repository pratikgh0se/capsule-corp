{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/rows/spool_event.v1.json",
  "title": "One Lookout spool line, t=event: the ops-pg event envelope (row 569; capsule/lookout.py Collector.collect, health every 10th pass)",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "t", "row"],
  "properties": {
    "v": {"const": 1},
    "t": {"const": "event"},
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "event_id", "ts", "kind", "source", "board", "task_id", "slug", "title", "text", "link", "severity", "payload"],
      "properties": {
        "v": {"const": 1},
        "event_id": {"type": "string", "pattern": "^[0-9a-f]{40}\\Z"},
        "ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+\\+00:00\\Z"},
        "kind": {"enum": ["card", "health"]},
        "source": {"const": "capsule"},
        "board": {"type": "string", "minLength": 1, "maxLength": 100},
        "task_id": {"maxLength": 100},
        "slug": {"maxLength": 200},
        "title": {"maxLength": 300},
        "text": {"maxLength": 500},
        "link": {"maxLength": 500},
        "severity": {"enum": ["info", "warn"]},
        "payload": {"type": "object"}
      }
    }
  }
}
