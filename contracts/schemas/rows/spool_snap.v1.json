{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/rows/spool_snap.v1.json",
  "title": "One Lookout spool line, t=snap: a table row snapshot (row 569; capsule/lookout.py Collector._snap, shipped by capsule/lookout_ship.py)",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "t", "board", "snap_ts", "pass_id", "table", "row"],
  "properties": {
    "v": {"const": 1},
    "t": {"const": "snap"},
    "board": {"type": "string", "minLength": 1, "maxLength": 100},
    "snap_ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+\\+00:00\\Z"},
    "pass_id": {"type": "string", "pattern": "^.+:[0-9]+:[0-9]+\\Z"},
    "table": {"enum": ["cap_cards", "cap_runs", "cap_blocks", "cap_epics", "cap_prs", "cap_commits", "cap_incidents"]},
    "row": {"type": "object"}
  }
}
