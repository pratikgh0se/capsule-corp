{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/rows/spool_tickmark.v1.json",
  "title": "One Lookout spool line, t=tickmark: the pass's liveness row (row 569; capsule/lookout.py Collector.collect)",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "t", "board", "snap_ts", "pass_id", "row"],
  "properties": {
    "v": {"const": 1},
    "t": {"const": "tickmark"},
    "board": {"type": "string", "minLength": 1, "maxLength": 100},
    "snap_ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+\\+00:00\\Z"},
    "pass_id": {"type": "string", "pattern": "^.+:[0-9]+:[0-9]+\\Z"},
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "pid", "harness_sha", "last_pass_at", "pass_ms", "lookout_ms", "counts", "running", "ready", "blocked", "paused_accounts", "spool_bytes_unshipped"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "pid": {"type": "integer", "minimum": 0},
        "harness_sha": {"type": "string", "minLength": 1},
        "last_pass_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+\\+00:00\\Z"},
        "pass_ms": {"type": "number", "minimum": 0},
        "lookout_ms": {"type": "number", "minimum": 0},
        "counts": {"type": "object"},
        "running": {"type": "integer", "minimum": 0},
        "ready": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "paused_accounts": {"type": "array", "items": {"type": "string"}},
        "spool_bytes_unshipped": {"type": "integer", "minimum": 0}
      }
    }
  }
}
