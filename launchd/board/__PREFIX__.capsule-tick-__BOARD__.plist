<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__PREFIX__.capsule-tick-__BOARD__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string><string>-u</string><string>-m</string>
    <string>capsule</string><string>tick</string><string>--replace</string><string>--board</string><string>__BOARD__</string>
  </array>
  <key>WorkingDirectory</key><string>__CAPSULE_HOME__/harness/main</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>CAPSULE_HOME</key><string>__CAPSULE_HOME__</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ExitTimeOut</key><integer>900</integer>
  <key>StandardOutPath</key><string>__CAPSULE_HOME__/logs/tick-__BOARD__.log</string>
  <key>StandardErrorPath</key><string>__CAPSULE_HOME__/logs/tick-__BOARD__.log</string>
</dict>
</plist>
