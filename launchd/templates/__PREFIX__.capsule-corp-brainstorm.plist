<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__PREFIX__.capsule-corp-brainstorm</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string><string>python3</string><string>-u</string><string>-m</string>
    <string>capsule.brainstorm_run</string>
  </array>
  <key>WorkingDirectory</key><string>__CAPSULE_HOME__/harness/main</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>OBSIDIAN_VAULT_PATH</key><string>__VAULT__</string>
    <key>CAPSULE_HOME</key><string>__CAPSULE_HOME__</string>
    <key>CAPSULE_BOARD</key><string>capsule-corp</string>
  </dict>
  <key>WatchPaths</key>
  <array><string>__CAPSULE_HOME__/boards/capsule-corp/brainstorms</string></array>
  <key>StartInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>__CAPSULE_HOME__/logs/brainstorm.log</string>
  <key>StandardErrorPath</key><string>__CAPSULE_HOME__/logs/brainstorm.log</string>
</dict>
</plist>
