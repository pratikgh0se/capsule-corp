<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__PREFIX__.capsule-corp-heal</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__CONFIG__/maintenance/run.sh</string>
    <string>heal</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key><string>__CONFIG__/maintenance/logs/launchd-heal.out</string>
  <key>StandardErrorPath</key><string>__CONFIG__/maintenance/logs/launchd-heal.err</string>
</dict>
</plist>
