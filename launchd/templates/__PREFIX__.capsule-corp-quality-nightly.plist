<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__PREFIX__.capsule-corp-quality-nightly</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__CONFIG__/maintenance/run.sh</string>
        <string>quality-nightly</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>10</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__CONFIG__/maintenance/logs/launchd-quality-nightly.out</string>
    <key>StandardErrorPath</key>
    <string>__CONFIG__/maintenance/logs/launchd-quality-nightly.err</string>
</dict>
</plist>
