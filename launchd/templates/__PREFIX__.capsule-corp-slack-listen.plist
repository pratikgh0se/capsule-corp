<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__PREFIX__.capsule-corp-slack-listen</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string><string>python3</string><string>-u</string><string>-m</string>
    <string>capsule.slack_listen</string>
  </array>
  <key>WorkingDirectory</key><string>__CAPSULE_HOME__/harness/main</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>CAPSULE_HOME</key><string>__CAPSULE_HOME__</string>
    <key>CAPSULE_BOARD</key><string>capsule-corp</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ExitTimeOut</key><integer>20</integer>
  <key>StandardOutPath</key><string>__CAPSULE_HOME__/logs/slack-listen.log</string>
  <key>StandardErrorPath</key><string>__CAPSULE_HOME__/logs/slack-listen.log</string>
</dict>
</plist>
