    {
      "id": 5,
      "title": "Rule inputs",
      "description": "What the window rules look at: the 5-hour and weekly usage percent.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select ts as time, (payload->>'session_pct')::float as \"5-hour window\", (payload->>'week_pct')::float as \"weekly window\" from events where kind = 'usage' and $__timeFilter(ts) order by 1"
        }
      ],
