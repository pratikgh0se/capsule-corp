  "templating": {
    "list": [
      {
        "name": "era",
        "label": "Era",
        "type": "custom",
        "hide": 2,
        "multi": false,
        "includeAll": false,
        "query": "capsule : capsule,hermes : hermes",
        "options": [
          {
            "selected": true,
            "text": "capsule",
            "value": "capsule"
          },
          {
            "selected": false,
            "text": "hermes",
            "value": "hermes"
          }
        ],
        "current": {
          "selected": true,
          "text": "capsule",
          "value": "capsule"
        },
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Spend, 7 days (estimate at list price)",
      "description": "Estimated cost of every agent run in range. A weight, not a bill.",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select coalesce(sum(r.usd_est), 0) as \"spend\" from v_run_cost r where r.era = '$era' and $__timeFilter(r.started_at)"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "links": []
    },
    {
      "id": 2,
      "title": "Tokens, 7 days",
      "description": "Input, output and cache tokens of every run in range.",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select coalesce(sum(coalesce(r.tokens_in, 0) + coalesce(r.tokens_out, 0) + coalesce(r.tokens_cache_read, 0) + coalesce(r.tokens_cache_write, 0)), 0) as \"tokens\" from v_run_cost r where r.era = '$era' and $__timeFilter(r.started_at)"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "links": []
    },
    {
      "id": 3,
      "title": "Cards worked on",
      "description": "Cards that had at least one agent run in range.",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select count(distinct (r.board, r.task_id)) as \"cards\" from v_run_cost r where r.era = '$era' and $__timeFilter(r.started_at)"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "links": []
    },
    {
      "id": 4,
      "title": "Runs with no price",
      "description": "Runs in range whose cost could not be worked out because the model has no price yet. Their cost shows as empty, so the spend above is too low by that much. Amber when any.",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select count(*) as \"runs with no price\" from v_run_cost r where r.era = '$era' and $__timeFilter(r.started_at) and r.usd_est is null"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "links": []
    },
    {
      "id": 5,
      "title": "Where each card's money went",
      "description": "The ten most expensive cards in range split by stage: builder, reviewer, tester. Tokens and run count on the right. Click a card for its story.",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select r.board as product, r.task_id as task_id, coalesce(c.title, '') as \"card title\", round(sum(r.usd_est)::numeric, 2) as \"cost\", round(sum(r.usd_est) filter (where r.role = 'implementer')::numeric, 2) as \"builder\", round(sum(r.usd_est) filter (where r.role = 'reviewer')::numeric, 2) as \"reviewer\", round(sum(r.usd_est) filter (where r.role = 'validator')::numeric, 2) as \"tester\", round(sum(r.usd_est) filter (where r.role not in ('implementer', 'reviewer', 'validator') or r.role is null)::numeric, 2) as \"other roles\", sum(coalesce(r.tokens_in, 0) + coalesce(r.tokens_out, 0) + coalesce(r.tokens_cache_read, 0) + coalesce(r.tokens_cache_write, 0)) as \"tokens\", count(*) as \"runs\" from v_run_cost r left join cap_cards c on c.board = r.board and c.task_id = r.task_id where r.era = '$era' and $__timeFilter(r.started_at) group by r.board, r.task_id, c.title order by 4 desc nulls last limit 10"
        }
      ],
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cost"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "builder"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "reviewer"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tester"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "other roles"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tokens"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "task_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Card story",
                    "url": "/d/lookout-trace?var-product=${__data.fields.product}&var-task_id=${__data.fields.task_id}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": []
      }
    },
    {
      "id": 6,
      "title": "Top 10 cards by tokens",
      "description": "The ten cards that used the most tokens in range.",
      "type": "bargauge",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select r.task_id as \"task_id\", sum(coalesce(r.tokens_in, 0) + coalesce(r.tokens_out, 0) + coalesce(r.tokens_cache_read, 0) + coalesce(r.tokens_cache_write, 0)) as \"tokens\" from v_run_cost r where r.era = '$era' and $__timeFilter(r.started_at) group by r.board, r.task_id order by 2 desc limit 10"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "orientation": "horizontal",
        "displayMode": "lcd",
        "valueMode": "color",
        "showUnfilled": true,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "sizing": "auto",
        "maxVizHeight": 300
      }
    }
  ]
}
