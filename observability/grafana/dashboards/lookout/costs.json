    {
      "id": 3,
      "title": "Factory cost, today and 7 days (estimate at list price)",
      "description": "What the agents cost: runs in v_run_cost priced from the prices table (Q9).",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select coalesce(sum(usd_est) filter (where (started_at at time zone 'Asia/Bangkok')::date = (now() at time zone 'Asia/Bangkok')::date), 0) as \"today\", coalesce(sum(usd_est), 0) as \"7 days\" from v_run_cost where board in ($product) and era = '$era' and role in ($role) and model in ($model) and started_at > now() - interval '7 days'"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
