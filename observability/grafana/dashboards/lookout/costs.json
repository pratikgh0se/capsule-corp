            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select (payload->>'session_pct')::float as \"session_pct\" from events where kind = 'usage' and ts > now() - interval '30 minutes' order by ts desc limit 1"
        }
      ],
