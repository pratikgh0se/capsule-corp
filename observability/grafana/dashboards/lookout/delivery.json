    {
      "id": 9,
      "title": "Review outcomes per card",
      "description": "One row per card; which cards bounced and where.",
      "type": "status-history",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select ts as time, task_id, what from v_card_story where board in ($product) and what in ('review started', 'committed', 'blocked') and $__timeFilter(ts) order by 1"
        }
      ],
      "gridPos": {
        "h": 8,
