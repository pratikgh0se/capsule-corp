                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 24
              },
              {
                "color": "red",
                "value": 72
              }
            ]
          },
          "unit": "h",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
