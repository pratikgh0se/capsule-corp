        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "links": []
    },
    {
      "id": 3,
      "title": "First-time pass rate",
      "description": "Share of cards that passed review in one round.",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select round(100.0 * count(*) filter (where review_rounds = 1) / nullif(count(*), 0), 1) as \"pass_pct\" from cap_commits where board in ($product) and coalesce(epic, '(none)') in ($epic) and $__timeFilter(committed_at)"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 0
