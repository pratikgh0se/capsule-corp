    {
      "id": 6,
      "title": "Card lead time",
      "description": "Hours from a card being created to its commit.",
      "type": "histogram",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select extract(epoch from m.committed_at - c.created_at) / 3600 as \"lead_h\" from cap_commits m join cap_cards c on c.board = m.board and c.task_id = m.task_id where m.board in ($product) and coalesce(m.epic, '(none)') in ($epic) and $__timeFilter(m.committed_at)"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "h",
          "noValue": "No card has gone dispatched -> merged in this window yet",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
