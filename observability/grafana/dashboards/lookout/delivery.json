    {
      "id": 7,
      "title": "Epic PRs",
      "description": "Every epic PR (Q6): state, checks, review, cards, key dates.",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select board as product, epic, pr_number as \"pr\", url, state, checks, review_decision as review, cards_in_pr as cards, opened_at, ready_at, merged_at from cap_prs where board in ($product) and epic in ($epic) order by updated_at desc"
        }
      ],
