    {
      "id": 8,
      "title": "Card commits",
      "description": "Each card's commit and the gates it passed (Q8).",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select board as product, task_id, epic, left(sha, 12) as \"commit\", 'https://github.com/' || repo || '/commit/' || sha as commit_url, validator, reviewer, guide, review_rounds as rounds, array_to_string(overrides, ', ') as overrides, pr_comment_url from cap_commits where board in ($product) and coalesce(epic, '(none)') in ($epic) and $__timeFilter(committed_at) order by committed_at desc"
