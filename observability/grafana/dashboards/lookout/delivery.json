    {
      "id": 4,
      "title": "PR wait for merge",
      "description": "Average hours a ready PR waits for your merge.",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select avg(extract(epoch from merged_at - ready_at)) / 3600 as \"wait_h\" from cap_prs where board in ($product) and epic in ($epic) and ready_at is not null and merged_at is not null and $__timeFilter(merged_at)"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 15,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
