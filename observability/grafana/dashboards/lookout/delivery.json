    {
      "id": 2,
      "title": "Cards delivered",
      "description": "Cards committed in range, with a daily trend.",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select date_trunc('day', committed_at at time zone 'Asia/Bangkok') as time, count(*) as \"cards\" from cap_commits where board in ($product) and coalesce(epic, '(none)') in ($epic) and $__timeFilter(committed_at) group by 1 order by 1"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 0
