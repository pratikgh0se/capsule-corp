        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "ops-pg"
        },
        "query": "select distinct coalesce(epic, '(none)') from cap_cards where board in ($product) order by 1",
        "definition": "select distinct coalesce(epic, '(none)') from cap_cards where board in ($product) order by 1",
