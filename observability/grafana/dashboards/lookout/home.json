            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select started_at as \"time\", task_id, role from cap_runs where board in ($product) and era = '$era' and $__timeFilter(started_at) union all select ended_at, task_id, 'idle' from cap_runs where board in ($product) and era = '$era' and ended_at is not null and $__timeFilter(ended_at) order by 1"
