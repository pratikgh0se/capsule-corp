    {
      "id": 13,
      "title": "Who worked on what",
      "description": "One row per card touched in range; the colour is the agent role on it.",
      "type": "state-timeline",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
