    {
      "id": 8,
      "title": "Budget windows",
      "description": "Limit used in the 5-hour and weekly windows, from the usage meter (the truth for limits, D6). Thresholds 60 / 70 / 80.",
      "type": "bargauge",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select (payload->>'session_pct')::float as \"5-hour window\", (payload->>'week_pct')::float as \"weekly window\" from events where kind = 'usage' and ts > now() - interval '30 minutes' order by ts desc limit 1"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 4
      },
