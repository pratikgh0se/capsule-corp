    {
      "id": 9,
      "title": "On the floor now",
      "description": "Every open card: product, epic, repo, card, what it is doing, which agent (role and model), for how long, and what it waits on (Q2-Q5).",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select product, epic, repo, task_id, title, phase_words as \"doing\", role, model, runner, elapsed_s, waiting_words as \"waiting on\" from v_floor where product in ($product) order by elapsed_s desc nulls last"
        }
      ],
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 8
