    {
      "id": 5,
      "title": "Shipped since you looked",
      "description": "Card commits plus merged epic PRs since the chosen moment (Q8).",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select (select count(*) from cap_commits where board in ($product) and committed_at >= $since) + (select count(*) from cap_prs where board in ($product) and merged_at >= $since) as \"shipped\""
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 13,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
