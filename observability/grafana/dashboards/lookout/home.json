    {
      "id": 4,
      "title": "Oldest wait",
      "description": "How long the oldest item in Waiting on you has waited.",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select coalesce(extract(epoch from now() - min(since))::bigint, 0) as \"oldest_s\" from v_waiting_on_owner where product in ($product)"
        }
      ],
