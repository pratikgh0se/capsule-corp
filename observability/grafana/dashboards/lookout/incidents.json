    {
      "id": 6,
      "title": "Open incidents by type",
      "description": "Open problems grouped by what happened, with how old the oldest one is.",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select case kind when 'human_intervention' then 'you stepped in' when 'contradiction' then 'rules disagreed' when 'runaway' then 'an agent ran away' when 'silent_failure' then 'something failed quietly' when 'crash' then 'an agent crashed' when 'lost_card_state' then 'a card lost its state' when 'override' then 'a check was overridden' when 'invalid_document' then 'an agent report was malformed' when 'escaped_bug' then 'a bug got through' when 'main_checkout_write' then 'main was written outside the gate' when 'repeat' then 'a problem came back' else replace(kind, '_', ' ') end as \"what happened\", count(*) as \"open\", extract(epoch from now() - min(opened_at))::bigint as \"oldest\" from cap_incidents where status not in ('closed', 'superseded') group by kind order by 2 desc"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "oldest"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": []
      }
    },
    {
      "id": 7,
      "title": "Came back again",
      "description": "Problems that returned within 30 days of being closed.",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
