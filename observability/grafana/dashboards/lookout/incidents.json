            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select case kind when 'human_intervention' then 'you stepped in' when 'contradiction' then 'rules disagreed' when 'runaway' then 'an agent ran away' when 'silent_failure' then 'something failed quietly' when 'crash' then 'an agent crashed' when 'lost_card_state' then 'a card lost its state' when 'override' then 'a check was overridden' when 'invalid_document' then 'an agent report was malformed' when 'escaped_bug' then 'a bug got through' when 'main_checkout_write' then 'main was written outside the gate' when 'repeat' then 'a problem came back' else replace(kind, '_', ' ') end as \"what came back\", coalesce(task_id, '-') as card, repeat_of as \"came back from\", extract(epoch from now() - opened_at)::bigint as \"opened ago\" from cap_incidents where (kind = 'repeat' or repeat_of is not null) and opened_at >= now() - interval '30 days' order by opened_at desc limit 15"
        }
