  "panels": [
    {
      "id": 1,
      "title": "Cards landed",
      "description": "Cards committed to main in range.",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select count(*) as \"landed\" from cap_commits m join cap_cards c on c.board = m.board and c.task_id = m.task_id where $__timeFilter(m.committed_at)"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "links": []
    },
    {
      "id": 2,
      "title": "Typical time to land",
      "description": "Median hours from a card's first build to its commit.",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select percentile_cont(0.5) within group (order by extract(epoch from m.committed_at - coalesce(c.started_at, c.created_at)) / 3600) as \"median\" from cap_commits m join cap_cards c on c.board = m.board and c.task_id = m.task_id where $__timeFilter(m.committed_at)"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 24
              }
            ]
          },
          "unit": "h",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "links": []
    },
    {
      "id": 3,
      "title": "Slowest to land",
      "description": "The longest hours from first build to commit in range.",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select max(extract(epoch from m.committed_at - coalesce(c.started_at, c.created_at)) / 3600) as \"slowest\" from cap_commits m join cap_cards c on c.board = m.board and c.task_id = m.task_id where $__timeFilter(m.committed_at)"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 12
              },
              {
                "color": "red",
                "value": 48
              }
            ]
          },
          "unit": "h",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "links": []
    },
    {
      "id": 4,
      "title": "Build, review and landing per card",
      "description": "One row per card, the 12 most recent. Blue building, purple in review, yellow testing, green landed, grey waiting.",
      "type": "state-timeline",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "with recent as (select board, task_id from cap_runs where era = '$era' and $__timeFilter(started_at) group by 1, 2 order by max(started_at) desc limit 12), seg as (select r.started_at as time, r.task_id as card, case r.role when 'implementer' then 'building' when 'reviewer' then 'in review' when 'validator' then 'testing' when 'guide' then 'guide ruling' when 'korin' then 'incident check' else 'working' end as stage, 1 as ord from cap_runs r join recent x on x.board = r.board and x.task_id = r.task_id where r.era = '$era' union all select coalesce(r.ended_at, now()), r.task_id, 'waiting', 0 from cap_runs r join recent x on x.board = r.board and x.task_id = r.task_id where r.era = '$era' union all select m.committed_at, m.task_id, 'landed', 1 from cap_commits m join recent x on x.board = m.board and x.task_id = m.task_id union all select m.committed_at + interval '20 minutes', m.task_id, 'waiting', 0 from cap_commits m join recent x on x.board = m.board and x.task_id = m.task_id) select time, card, stage from seg order by time, ord"
        }
      ],
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "building": {
                  "color": "blue",
                  "index": 0
                },
                "in review": {
                  "color": "purple",
                  "index": 1
                },
                "testing": {
                  "color": "yellow",
                  "index": 2
                },
                "guide ruling": {
                  "color": "orange",
                  "index": 3
                },
                "incident check": {
                  "color": "red",
                  "index": 4
                },
                "working": {
                  "color": "text",
                  "index": 5
                },
                "landed": {
                  "color": "green",
                  "index": 6
                },
                "waiting": {
                  "color": "#3d3d3d",
                  "index": 7
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "no data",
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 70,
            "spanNulls": false,
            "insertNulls": false,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.8,
        "perPage": 20,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "card"
            ],
            "keepFields": false
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Time to land per card",
      "description": "The 15 newest landed cards: hours from first build to commit and how many review rounds it took. Click a card for its story.",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select m.board as product, m.task_id as task_id, coalesce(c.title, '') as \"card title\", round((extract(epoch from m.committed_at - coalesce(c.started_at, c.created_at)) / 3600)::numeric, 1) as \"hours to land\", m.review_rounds as \"review rounds\", m.committed_at as \"landed at\" from cap_commits m join cap_cards c on c.board = m.board and c.task_id = m.task_id where $__timeFilter(m.committed_at) order by m.committed_at desc limit 15"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "hours to land"
            },
            "properties": [
              {
                "id": "unit",
                "value": "h"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "task_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Card story",
                    "url": "/d/lookout-trace?var-product=${__data.fields.product}&var-task_id=${__data.fields.task_id}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": []
      }
    }
  ]
}
