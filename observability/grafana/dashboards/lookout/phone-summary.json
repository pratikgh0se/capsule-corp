  "panels": [
    {
      "id": 1,
      "title": "Factory running?",
      "description": "Is the capsule-corp tick alive (its last pass is under 90 seconds old). Green running, amber late or paused for budget, red stopped or no report.",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select coalesce(max(case state_words when 'running' then 0 when 'late' then 1 when 'paused (budget)' then 2 else 3 end), 3) as \"factory\" from v_factory where board = 'capsule-corp'"
        }
      ],
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "running",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "late",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "paused (budget)",
                  "color": "orange",
                  "index": 2
                },
                "3": {
                  "text": "stopped",
                  "color": "red",
                  "index": 3
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "none",
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "links": []
    },
    {
      "id": 2,
      "title": "Cards in progress",
      "description": "capsule-corp cards an agent is working on right now (building, validating, reviewing, guide ruling, Korin, or in review).",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select count(*) as \"cards in progress\" from cap_cards where board = 'capsule-corp' and (phase in ('implementing', 'validating', 'reviewing', 'guide_ruling', 'korin') or status in ('running', 'review'))"
        }
      ],
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
