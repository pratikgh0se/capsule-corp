    {
      "id": 9,
      "title": "Offline test",
      "description": "Whether the factory's offline test passes. Red means failing, amber means unknown.",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select coalesce((select case when ok is true then 'passing' when ok is false then 'FAILING' end from live_health where check_name = 'offline_test' limit 1), 'unknown') as \"offline test\""
        }
      ],
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "passing": {
                  "color": "green",
                  "index": 0
                },
                "FAILING": {
                  "color": "red",
                  "index": 1
                },
                "unknown": {
                  "color": "orange",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "string",
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
