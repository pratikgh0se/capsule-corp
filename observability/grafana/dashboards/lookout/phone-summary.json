          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select coalesce(sum(usd_est), 0) as \"spend today\" from v_run_cost where era = '$era' and (started_at at time zone 'Asia/Bangkok')::date = (now() at time zone 'Asia/Bangkok')::date"
