    {
      "id": 3,
      "title": "Blocked",
      "description": "Scope: capsule-corp board, status blocked, cards you parked on purpose or that failed too often left out. Amber when any.",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select count(*) as \"blocked cards\" from cap_cards where board = 'capsule-corp' and status = 'blocked' and phase <> 'archived' and coalesce(block_kind, '') not in ('parked', 'parked_by_human', 'failure_limit')"
