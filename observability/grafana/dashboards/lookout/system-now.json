    {
      "id": 20,
      "title": "Cards finished",
      "description": "Cards done or landed in the last 6 hours, newest first.",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select c.board as project, c.task_id as card, c.title as \"card title\", coalesce(c.epic, '(no epic)') as branch, coalesce(m.committed_at, c.completed_at) as finished, case when m.sha is not null then 'landed' else 'done' end as outcome from cap_cards c left join lateral (select sha, committed_at from cap_commits m where m.board = c.board and m.task_id = c.task_id order by committed_at desc limit 1) m on true where (c.phase = 'done' and c.completed_at >= now() - interval '6 hours') or m.committed_at >= now() - interval '6 hours' order by finished desc"
        }
