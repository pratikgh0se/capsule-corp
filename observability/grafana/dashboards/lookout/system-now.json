    {
      "id": 10,
      "title": "Running agents",
      "description": "One row per agent running now: project, card, role, container and how long.",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select f.product as project, f.task_id as card, f.title as \"card title\", case f.role when 'implementer' then 'builder' when 'reviewer' then 'reviewer' when 'validator' then 'tester' when 'guide' then 'guide' when 'korin' then 'incident investigator' else coalesce(f.role, 'unknown') end as role, coalesce(c.name, 'none found') as container, now() - f.elapsed_s * interval '1 second' as started, f.elapsed_s as \"running for\" from v_floor f left join live_containers c on c.run_id = f.run_id or c.name = 'capsule-' || left(f.run_id, 12) where f.run_id is not null order by f.elapsed_s desc"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "running for"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "card"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Card story",
                    "url": "/d/lookout-trace?var-product=${__data.fields.project}&var-task_id=${__data.fields.card}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": []
      }
    },
    {
      "id": 12,
      "title": "One row per branch",
      "description": "The card running on each epic branch, how many wait, and why.",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "with lanes as (select board, coalesce(epic, '(no epic)') as epic, max(case when phase in ('implementing', 'validating', 'reviewing', 'guide_ruling', 'korin') then task_id || ': ' || coalesce(title, '') end) as live, count(*) filter (where phase = 'queued' and status in ('ready', 'todo')) as queued, min(waiting_words) filter (where phase = 'queued' and status in ('ready', 'todo')) as why from cap_cards where phase not in ('done', 'archived') group by 1, 2) select board as project, epic as branch, coalesce(live, 'nothing running') as \"live card\", queued as \"queued cards\", case when queued = 0 then 'nothing waiting' when live is not null then 'waiting: another card is using this branch' when why like 'waiting for card%' or why like 'retrying%' then 'waiting: ' || why else 'next in line, starts on the next pass' end as \"why waiting\" from lanes order by board, epic"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": []
      }
    },
    {
      "id": 14,
      "title": "Blocked cards",
      "description": "Cards that are blocked or in triage, with the reason and how long ago.",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select board as project, task_id as card, title as \"card title\", case when waiting_on = 'owner' then 'needs you: ' else 'waiting: ' end || coalesce(waiting_words, status) as \"why\", left(block_reason, 160) as details, extract(epoch from now() - coalesce(waiting_since, snap_ts))::bigint as \"waiting for\" from cap_cards where status in ('blocked', 'triage') and phase <> 'archived' order by 6 desc"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
