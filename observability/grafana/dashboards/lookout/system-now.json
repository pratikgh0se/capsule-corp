    {
      "id": 2,
      "title": "Is everything up?",
      "description": "One tile per part: each factory loop, Postgres, Loki, Grafana, Infisical and the offline test. Green is fine, red needs a look.",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select label, case when ok then 'OK' when check_name = 'offline_test' then 'FAILING' else 'DOWN' end as \"state\" from live_health where check_name <> 'disk' order by case when check_name like 'loop:%' then 0 when check_name like 'svc:%' then 1 else 2 end, label"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 18,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "OK": {
                  "color": "green",
                  "index": 0
                },
                "DOWN": {
                  "color": "red",
                  "index": 1
                },
                "FAILING": {
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "string",
          "noValue": "no data",
          "displayName": "${__data.fields.label}"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^state$/",
          "values": true
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "links": []
    },
