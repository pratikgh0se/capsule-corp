      {
        "name": "task_id",
        "label": "Card",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "ops-pg"
        },
        "query": "select task_id from cap_cards where board = '$product' order by snap_ts desc",
        "definition": "select task_id from cap_cards where board = '$product' order by snap_ts desc",
        "refresh": 2,
