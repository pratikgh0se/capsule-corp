  "templating": {
    "list": [
      {
        "name": "product",
        "label": "Product",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "ops-pg"
        },
        "query": "select board from v_factory union select board from cap_cards order by 1",
        "definition": "select board from v_factory union select board from cap_cards order by 1",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {},
        "options": [],
        "sort": 1,
        "skipUrlSync": false,
        "regex": ""
