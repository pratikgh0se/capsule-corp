            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select ts as time,\n  (labels->>'board') || ' ' || (labels->>'status') as metric, value\nfrom samples where service='capsule' and name='capsule.board.cards'\n  and $__timeFilter(ts) order by ts"
