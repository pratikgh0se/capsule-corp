    {
      "id": 6,
      "title": "Cards per status per board",
      "description": "capsule.board.cards, one series per board+status pair, stacked.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
