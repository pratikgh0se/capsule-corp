    {
      "id": 1,
      "type": "text",
      "title": "Are the boards moving?",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "Card flow and run outcomes across every kanban board the probe can open. A board with cards piling up in one status, or failures that never clear, needs a look."
      },
      "transparent": false,
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 2,
