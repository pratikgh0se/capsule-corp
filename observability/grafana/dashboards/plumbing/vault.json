      "description": "Errors and warnings from the freshness and link linters, from the last vault sample of each day. Errors are broken references; warnings are notes going stale. A gap means that checker did not run that day - the series is deliberately not zero-filled, so a gap is never read as clean.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select distinct on (date_trunc('day', ts)) date_trunc('day', ts) as time,\n  (payload->>'freshness_errors')::int as \"freshness errors\",\n  (payload->>'link_errors')::int as \"link errors\",\n  (payload->>'freshness_warnings')::int as \"freshness warnings\",\n  (payload->>'link_warnings')::int as \"link warnings\"\nfrom events where kind='vault' and $__timeFilter(ts)\norder by date_trunc('day', ts), ts desc"
