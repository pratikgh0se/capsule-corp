    {
      "id": 10,
      "title": "Vault jobs, 30 d",
      "description": "One lane per vault maintenance job, one cell per day: green exited 0, red did not, grey means it did not run.",
      "type": "status-history",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "with days as (select generate_series(date_trunc('day', now() - interval '29 days'),\n                                     date_trunc('day', now()), interval '1 day') as d),\n j as (select date_trunc('day', ts) as d, payload->>'job' as job,\n              max((payload->>'exit')::int) as worst\n       from events where kind='job' and payload->>'phase'='end'\n         and ts > now() - interval '30 days' group by 1,2)\nselect days.d as time,\n  coalesce((select case when j.worst = 0 then 'ok' else 'failed' end from j\n    where j.d = days.d and j.job = 'morning'), 'no run') as \"morning\",\n  coalesce((select case when j.worst = 0 then 'ok' else 'failed' end from j\n    where j.d = days.d and j.job = 'nightly'), 'no run') as \"nightly\",\n  coalesce((select case when j.worst = 0 then 'ok' else 'failed' end from j\n    where j.d = days.d and j.job = 'report'), 'no run') as \"report\",\n  coalesce((select case when j.worst = 0 then 'ok' else 'failed' end from j\n    where j.d = days.d and j.job = 'inbox'), 'no run') as \"inbox\",\n  coalesce((select case when j.worst = 0 then 'ok' else 'failed' end from j\n    where j.d = days.d and j.job = 'weekly'), 'no run') as \"weekly\",\n  coalesce((select case when j.worst = 0 then 'ok' else 'failed' end from j\n    where j.d = days.d and j.job = 'security'), 'no run') as \"security\",\n  coalesce((select case when j.worst = 0 then 'ok' else 'failed' end from j\n    where j.d = days.d and j.job = 'agent-review'), 'no run') as \"agent-review\",\n  coalesce((select case when j.worst = 0 then 'ok' else 'failed' end from j\n    where j.d = days.d and j.job = 'cleanup'), 'no run') as \"cleanup\"\nfrom days order by 1"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "ok": {
                  "color": "green",
                  "index": 0
                },
                "up": {
                  "color": "green",
                  "index": 1
                },
                "failed": {
                  "color": "red",
                  "index": 2
                },
                "DOWN": {
                  "color": "red",
                  "index": 3
                },
                "missing": {
                  "color": "red",
                  "index": 4
                },
                "no run": {
                  "color": "#4d4d4d",
                  "index": 5
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "no data",
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 70,
            "spanNulls": false,
            "insertNulls": false,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "colWidth": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
